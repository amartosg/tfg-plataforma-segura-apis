# ─────────────────────────────────────────────────────────────────────────────
# .env.example — plantilla segura para la PoC del TFG
#
# Uso:
#   cp .env.example .env
#   Editar .env con valores reales del entorno local.
#
# IMPORTANTE:
#   - No commitear nunca el fichero .env.
#   - No incluir secretos reales en esta plantilla.
#   - Rotar cualquier secreto que haya sido publicado por error.
# ─────────────────────────────────────────────────────────────────────────────

ASPNETCORE_ENVIRONMENT=Development

# Microsoft Entra ID
ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_CLIENT_SECRET=change-me-local-only
ENTRA_RESOURCE_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_AUTHORITY=https://login.microsoftonline.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/v2.0
ENTRA_AUDIENCE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Kong Gateway / PostgreSQL
KONG_PG_PASSWORD=change-me-local-only
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_STATUS_PORT=8100

# APIs .NET
CLIENTES_API_PORT=8081
CUENTAS_API_PORT=8082

# Observabilidad
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Benchmark de overhead
DIRECT_HOST=http://localhost:8081
KONG_HOST=http://localhost:8000
DIRECT_ENDPOINT=http://localhost:8081/health
KONG_ENDPOINT=http://localhost:8000/clientes
WARMUP=20
